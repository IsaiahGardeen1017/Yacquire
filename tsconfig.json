{
    "compilerOptions": {
        "strict": true,
        "target": "ESNext",
        "module": "ESNext",
        "allowSyntheticDefaultImports": true,
        "allowArbitraryExtensions": true,
        "esModuleInterop": true,
        "jsx": "preserve",
        "jsxImportSource": "solid-js",
        "types": [
            "vite/client",
            "@testing-library/jest-dom"
        ],
        "outDir": "build/server",
        "sourceMap": true,
        "moduleResolution": "bundler" // Or "node"
    }
}